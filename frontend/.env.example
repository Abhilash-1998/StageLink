# gigZee Frontend — environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# gigZee Frontend — environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# Backend base URL (no trailing slash). Code reads EXPO_PUBLIC_BACKEND_URL.
# All API calls go to `${EXPO_PUBLIC_BACKEND_URL}/api/...`
EXPO_PUBLIC_BACKEND_URL=https://stagelink-api-production-f0c5.up.railway.app

# EAS project UUID — required for Expo push tokens.
# Also set in app.json → expo.extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=01fadb01-21e3-41f6-a377-82857e21445f

# Performance tip for physical devices:
# Prefer LAN over Tunnel when scanning the QR code.
#   npx expo start --lan
# Tunnel is much slower (JS bundle + HMR go through Expo's servers).
#
# Push notifications (SDK 53+):
# Expo Go cannot receive remote push. Use a development build:
#   npx expo run:android
#   npx expo run:ios --device
# Android also needs FCM V1 credentials uploaded via `eas credentials`.

# ─── Do NOT change these two on Emergent's managed environment ───────────
EXPO_PACKAGER_PROXY_URL=
EXPO_PACKAGER_HOSTNAME=
