# StageLink Frontend — environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# Backend base URL. All API calls are made to `${EXPO_BACKEND_URL}/api/...`.
# For local dev, point at your FastAPI server (default port 8001).
EXPO_BACKEND_URL=http://localhost:8001

# ─── Do NOT change these two on Emergent's managed environment ───────────
# They are injected by the container and used by Metro to serve previews.
# Leave them empty in your local .env — they're not needed outside Emergent.
EXPO_PACKAGER_PROXY_URL=
EXPO_PACKAGER_HOSTNAME=
