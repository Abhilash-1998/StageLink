# gigZee Backend — environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# PostgreSQL connection string (asyncpg).
# Local example: postgresql://postgres:postgres@localhost:5432/gigze
# Railway: set automatically via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gigze

# JWT signing secret — MUST be long, random, and unique in production.
JWT_SECRET=change-me-to-a-long-random-string

# Resend (transactional email)
# https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=
# Staging/testing: onboarding@resend.dev (Resend sandbox — can only deliver TO your Resend account email)
# Production: use a verified domain, e.g. gigZee <noreply@yourdomain.com>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Pre-signup email OTP (defaults shown match server behaviour)
SIGNUP_OTP_TTL_SECONDS=600
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
SIGNUP_OTP_MAX_ATTEMPTS=5
SIGNUP_OTP_MAX_SENDS_PER_HOUR=5
SIGNUP_OTP_MAX_IP_PER_HOUR=30
SIGNUP_VERIFICATION_TOKEN_TTL_SECONDS=900

# Registration (POST /api/auth/register) requires verification_token from
# POST /api/auth/verify-signup-otp after email OTP verification.

# Emergent Universal LLM key. Powers Gemini/Claude/OpenAI features via
# the `emergentintegrations` library. Get one from your Emergent profile.
EMERGENT_LLM_KEY=your-emergent-universal-key
