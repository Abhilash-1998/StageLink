# gigZee Backend — environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# PostgreSQL connection string (asyncpg).
# Local example: postgresql://postgres:postgres@localhost:5432/gigze
# Railway: set automatically via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gigze

# JWT signing secret — MUST be long, random, and unique in production.
JWT_SECRET=change-me-to-a-long-random-string

# Emergent Universal LLM key. Powers Gemini/Claude/OpenAI features via
# the `emergentintegrations` library. Get one from your Emergent profile.
EMERGENT_LLM_KEY=your-emergent-universal-key
